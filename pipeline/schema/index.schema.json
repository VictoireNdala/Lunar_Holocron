{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lunar-holocron/index.schema.json",
  "title": "index.json — contrat de données 1.x (docs/CONTRAT-DONNEES.md § 2)",
  "description": "Les contrôles croisés (synthetic racine, identifiants uniques, chemins cohérents avec l'id) sont faits par pipeline/validate.py.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_utc",
    "synthetic",
    "sites"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "generated_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "lat_deg",
          "lon_deg",
          "synthetic",
          "verified",
          "site_file",
          "terrain_file"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "object",
            "required": [
              "fr",
              "en"
            ],
            "properties": {
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              },
              "sw": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "lat_deg": {
            "type": "number",
            "minimum": -89.99,
            "maximum": 89.99
          },
          "lon_deg": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "synthetic": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          },
          "terrain_real": {
            "type": "boolean"
          },
          "ephemeris_synthetic": {
            "type": "boolean"
          },
          "tier": {
            "type": "integer",
            "minimum": 1
          },
          "lola_priority_site": {
            "type": "boolean"
          },
          "nasa_2024_region": {
            "type": [
              "string",
              "null"
            ]
          },
          "pgda_id": {
            "type": "string"
          },
          "site_file": {
            "type": "string",
            "pattern": "^sites/[a-z0-9]+(-[a-z0-9]+)*\\.json$"
          },
          "terrain_file": {
            "type": "string",
            "pattern": "^terrain/[a-z0-9]+(-[a-z0-9]+)*\\.json$"
          },
          "kind": {
            "enum": [
              "lola_site",
              "feature",
              "nasa_region",
              "mission",
              "apollo"
            ]
          },
          "position_basis": {
            "type": "string"
          },
          "approximate": {
            "type": "boolean"
          },
          "position_uncertainty_km": {
            "type": "number",
            "minimum": 0
          },
          "terrain_tier": {
            "enum": [
              "5m",
              "80m",
              "flat"
            ]
          },
          "terrain_modeled": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "landed",
              "planned",
              "failed",
              "candidate",
              "reference"
            ]
          },
          "mission": {
            "type": "string"
          },
          "interest": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "ref"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "h_enhanced",
                    "psr",
                    "illumination",
                    "dte",
                    "lcross"
                  ]
                },
                "ref": {
                  "type": "string"
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "url",
                "read_utc"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "read_utc": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
