{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lunar-holocron/site.schema.json",
  "title": "sites/<id>.json — contrat de données 1.x (docs/CONTRAT-DONNEES.md § 3)",
  "description": "Les contrôles croisés (longueur des séries = time.count, cohérence de synthetic, mois couverts, fenêtre des indicateurs) sont faits par pipeline/validate.py.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "synthetic",
    "location",
    "provenance",
    "horizon",
    "time",
    "bodies",
    "kpis",
    "monthly"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "id": {
      "$ref": "#/$defs/site_id"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "synthetic": {
      "type": "boolean"
    },
    "terrain_real": {
      "type": "boolean"
    },
    "ephemeris_synthetic": {
      "type": "boolean"
    },
    "location": {
      "type": "object",
      "required": [
        "lat_deg",
        "lon_deg",
        "ground_height_m",
        "observer_height_m",
        "frame",
        "r_ref_m"
      ],
      "properties": {
        "lat_deg": {
          "$ref": "#/$defs/lat_deg"
        },
        "lon_deg": {
          "$ref": "#/$defs/lon_deg"
        },
        "ground_height_m": {
          "type": "number"
        },
        "observer_height_m": {
          "type": "number",
          "minimum": 0
        },
        "frame": {
          "const": "MOON_ME"
        },
        "r_ref_m": {
          "const": 1737400.0
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "dem",
        "ephemeris",
        "pipeline_version",
        "generated_utc"
      ],
      "properties": {
        "dem": {
          "type": "object",
          "required": [
            "product",
            "resolution_m",
            "source",
            "license"
          ],
          "properties": {
            "product": {
              "type": "string",
              "minLength": 1
            },
            "resolution_m": {
              "type": "number",
              "minimum": 0
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "filled_nodes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "ephemeris": {
          "type": "object",
          "required": [
            "engine",
            "kernels",
            "abcorr"
          ],
          "properties": {
            "engine": {
              "enum": [
                "demo-analytic",
                "spice"
              ]
            },
            "kernels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "abcorr": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "pipeline_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_utc": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "horizon": {
      "type": "object",
      "required": [
        "az_step_deg",
        "elev_deg",
        "truncated",
        "max_distance_km"
      ],
      "properties": {
        "az_step_deg": {
          "const": 1.0
        },
        "elev_deg": {
          "type": "array",
          "minItems": 360,
          "maxItems": 360,
          "items": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          }
        },
        "truncated": {
          "type": "array",
          "minItems": 360,
          "maxItems": 360,
          "items": {
            "type": "boolean"
          }
        },
        "max_distance_km": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "time": {
      "type": "object",
      "required": [
        "start_utc",
        "step_s",
        "count"
      ],
      "properties": {
        "start_utc": {
          "$ref": "#/$defs/utc"
        },
        "step_s": {
          "type": "integer",
          "minimum": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "bodies": {
      "type": "object",
      "required": [
        "sun",
        "earth"
      ],
      "properties": {
        "sun": {
          "$ref": "#/$defs/body_series"
        },
        "earth": {
          "$ref": "#/$defs/body_series"
        }
      }
    },
    "kpis": {
      "type": "object",
      "required": [
        "window",
        "sun",
        "earth",
        "both",
        "sun_el_deg",
        "earth_el_deg"
      ],
      "properties": {
        "window": {
          "type": "object",
          "required": [
            "start_utc",
            "end_utc"
          ],
          "properties": {
            "start_utc": {
              "$ref": "#/$defs/utc"
            },
            "end_utc": {
              "$ref": "#/$defs/utc"
            }
          }
        },
        "sun": {
          "$ref": "#/$defs/kpi_pair"
        },
        "earth": {
          "$ref": "#/$defs/kpi_pair"
        },
        "both": {
          "$ref": "#/$defs/kpi_pair"
        },
        "sun_el_deg": {
          "$ref": "#/$defs/min_max_deg"
        },
        "earth_el_deg": {
          "$ref": "#/$defs/min_max_deg"
        }
      }
    },
    "monthly": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ym",
          "sun_strict_pct",
          "earth_strict_pct",
          "both_strict_pct"
        ],
        "properties": {
          "ym": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "sun_strict_pct": {
            "$ref": "#/$defs/pct"
          },
          "earth_strict_pct": {
            "$ref": "#/$defs/pct"
          },
          "both_strict_pct": {
            "$ref": "#/$defs/pct"
          }
        }
      }
    },
    "kind": {
      "enum": [
        "lola_site",
        "feature",
        "nasa_region",
        "mission",
        "apollo"
      ]
    },
    "position_basis": {
      "type": "string"
    },
    "approximate": {
      "type": "boolean"
    },
    "position_uncertainty_km": {
      "type": "number",
      "minimum": 0
    },
    "terrain_tier": {
      "enum": [
        "5m",
        "80m",
        "flat"
      ]
    },
    "terrain_modeled": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "landed",
        "planned",
        "failed",
        "candidate",
        "reference"
      ]
    },
    "mission": {
      "type": "string"
    },
    "interest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "h_enhanced",
              "psr",
              "illumination",
              "dte",
              "lcross"
            ]
          },
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "url",
          "read_utc"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "read_utc": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "site_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "object",
      "required": [
        "fr",
        "en"
      ],
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "sw": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lat_deg": {
      "type": "number",
      "minimum": -89.99,
      "maximum": 89.99
    },
    "lon_deg": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "body_series": {
      "type": "object",
      "required": [
        "az_mdeg",
        "el_mdeg",
        "radius_mdeg"
      ],
      "properties": {
        "az_mdeg": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359999
          }
        },
        "el_mdeg": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -90000,
            "maximum": 90000
          }
        },
        "radius_mdeg": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "kpi_block": {
      "type": "object",
      "required": [
        "visible_pct",
        "longest_gap_h",
        "n_gaps"
      ],
      "properties": {
        "visible_pct": {
          "$ref": "#/$defs/pct"
        },
        "longest_gap_h": {
          "type": "number",
          "minimum": 0
        },
        "n_gaps": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "kpi_pair": {
      "type": "object",
      "required": [
        "strict",
        "any"
      ],
      "properties": {
        "strict": {
          "$ref": "#/$defs/kpi_block"
        },
        "any": {
          "$ref": "#/$defs/kpi_block"
        }
      }
    },
    "min_max_deg": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "max": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    }
  }
}
