    { "el_deg": 0.135,   "horizon_deg": 0.0, "f": 0.804499, "strict": true,  "any": true,  "note": "" },
    { "el_deg": 0.0675,  "horizon_deg": 0.0, "f": 0.657481, "strict": true,  "any": true,  "note": "" },
    { "el_deg": 0.0,     "horizon_deg": 0.0, "f": 0.500000, "strict": true,  "any": true,  "note": "centre exactement sur l'horizon" },
    { "el_deg": -0.0675, "horizon_deg": 0.0, "f": 0.342519, "strict": false, "any": true,  "note": "" },
    { "el_deg": -0.135,  "horizon_deg": 0.0, "f": 0.195501, "strict": false, "any": true,  "note": "" },
    { "el_deg": -0.27,   "horizon_deg": 0.0, "f": 0.000000, "strict": false, "any": false, "note": "disque tangent, entièrement sous l'horizon" },
    { "el_deg": 0.5,     "horizon_deg": 0.0, "f": 1.000000, "strict": true,  "any": true,  "note": "saturation" },
    { "el_deg": -0.5,    "horizon_deg": 0.0, "f": 0.000000, "strict": false, "any": false, "note": "saturation" },
    { "el_deg": 3.135,   "horizon_deg": 3.0, "f": 0.804499, "strict": true,  "any": true,  "note": "même d = 0,135 avec un horizon non nul" },
    { "el_deg": -1.135,  "horizon_deg": -1.0, "f": 0.195501, "strict": false, "any": true, "note": "même d = -0,135 avec un horizon négatif" }
  ]
}
